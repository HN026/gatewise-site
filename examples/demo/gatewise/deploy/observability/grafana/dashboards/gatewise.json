  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gatewise-prometheus"
        },
        "query": {
          "query": "label_values(gatewise_service_info, instance)",
          "refId": "instance"
        },
        "definition": "label_values(gatewise_service_info, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gatewise-prometheus"
        },
        "query": {
          "query": "label_values(gatewise_service_info{instance=~\"$instance\"}, service)",
