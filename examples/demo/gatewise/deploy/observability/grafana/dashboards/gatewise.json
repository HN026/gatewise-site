    {
      "id": 6,
      "title": "Rejected share of admission attempts",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gatewise-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(instance,service) (rate(gatewise_requests_rejected_total{service=~\"$service\",instance=~\"$instance\",job=\"gatewise\"}[$__rate_interval])) / clamp_min(sum by(instance,service) (rate(gatewise_requests_rejected_total{service=~\"$service\",instance=~\"$instance\",job=\"gatewise\"}[$__rate_interval])) + sum by(instance,service) (rate(gatewise_requests_admitted_total{service=~\"$service\",instance=~\"$instance\",job=\"gatewise\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{instance}} {{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gatewise-prometheus"
          },
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Admitted completed work \u2014 p95 latency",
      "type": "timeseries",
      "description": "Admission rejections and canceled/panicked work are excluded; HTTP errors returned by handlers remain included.",
      "datasource": {
        "type": "prometheus",
        "uid": "gatewise-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,instance,service,priority) (rate(gatewise_request_duration_seconds_bucket{service=~\"$service\",instance=~\"$instance\",job=\"gatewise\",outcome=\"completed\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} {{service}} {{priority}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gatewise-prometheus"
          },
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
