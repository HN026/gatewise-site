# Copy to .env. Process environment takes precedence over this file.
GATEWISE_LISTEN_ADDR=127.0.0.1:8080
GATEWISE_SERVICE_USERS_URL=http://127.0.0.1:9090
GATEWISE_SERVICE_CATALOG_URL=http://127.0.0.1:9091
GATEWISE_DIAL_TIMEOUT=2s
GATEWISE_RESPONSE_HEADER_TIMEOUT=2s
GATEWISE_SHUTDOWN_TIMEOUT=5s

# Optional per-service limit overrides (local JSON sets both to 2).
# GATEWISE_SERVICE_USERS_MAX_CONCURRENT=2
# GATEWISE_SERVICE_CATALOG_MAX_CONCURRENT=2

# Critical capacity reservation per service (local JSON sets both to 1).
# GATEWISE_SERVICE_USERS_RESERVED_CRITICAL=1
# GATEWISE_SERVICE_CATALOG_RESERVED_CRITICAL=1

# Optional adaptive mode overrides (use configs/adaptive.json for the demo).
# GATEWISE_SERVICE_USERS_MODE=adaptive
# GATEWISE_SERVICE_USERS_ADAPTIVE_MIN_CONCURRENT=2
# GATEWISE_SERVICE_USERS_ADAPTIVE_INITIAL_CONCURRENT=4
# GATEWISE_SERVICE_USERS_ADAPTIVE_INTERVAL=500ms
# GATEWISE_SERVICE_USERS_ADAPTIVE_MIN_SAMPLES=4
# GATEWISE_SERVICE_USERS_ADAPTIVE_TARGET_LATENCY=100ms
