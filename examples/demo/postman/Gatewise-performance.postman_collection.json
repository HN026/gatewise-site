{
  "info": {
    "name": "Gatewise manual load",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. critical work",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{benchmarkBaseUrl}}/critical/work"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected completion or admission shedding\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
              "pm.test(\"Response agrees with status\", () => { const body = pm.response.json(); if (pm.response.code === 200) pm.expect(body.status).to.eql(\"ok\"); else pm.expect(body.error).to.eql(\"service_overloaded\"); });"
            ]
          }
        }
      ]
    },
