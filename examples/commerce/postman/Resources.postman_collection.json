{
  "info": {
    "name": "Gatewise real resource regulators",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real Go memory/goroutine measurements and PostgreSQL logical writes/key contention. Run run.py --resources enforce/observe/disabled --verify. Loopback planner metadata is trusted only for this isolated example."
  },
  "item": [
    {
      "name": "Measure real memory",
      "request": {
        "method": "GET",
        "url": "{{catalog_admin}}/resource/signals/memory",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"measured observation\",()=>{pm.response.to.have.status(200);const o=pm.response.json();pm.expect(o.state).to.eql(\"measured\");pm.expect(o.value).to.be.at.least(0);pm.expect(Date.now()-Date.parse(o.observed_at)).to.be.below(3000);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Measure real goroutines",
      "request": {
        "method": "GET",
        "url": "{{catalog_admin}}/resource/signals/goroutines",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"measured observation\",()=>{pm.response.to.have.status(200);const o=pm.response.json();pm.expect(o.state).to.eql(\"measured\");pm.expect(o.value).to.be.at.least(0);pm.expect(Date.now()-Date.parse(o.observed_at)).to.be.below(3000);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Healthy resource configuration",
      "request": {
        "method": "PUT",
        "url": "{{catalog_admin}}/resource/control",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"hold_ms\": 20, \"collect\": true, \"reset_peaks\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"control accepted\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Healthy allocation avoids false rejection",
      "request": {
        "method": "POST",
        "url": "{{catalog_url}}/catalog/resource/allocation",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"bytes\": 65536}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"low-cost work succeeds\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Healthy fanout avoids false rejection",
      "request": {
        "method": "POST",
        "url": "{{catalog_url}}/catalog/resource/fanout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workers\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"low-cost work succeeds\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Healthy write",
      "request": {
        "method": "POST",
        "url": "{{catalog_url}}/catalog/resource/write",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Gatewise-Cost",
            "value": "{\"write_bytes\": 1024, \"key\": \"healthy-contract\"}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"bytes\": 1024, \"key\": \"healthy-contract\", \"workers\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"healthy work succeeds\",()=>pm.response.to.have.status(200));",
              "pm.test(\"actual planned bytes written\",()=>pm.expect(pm.response.json().logical_write_bytes).to.eql(1024));"
            ]
          }
        }
      ]
    },
    {
      "name": "Healthy key_write",
      "request": {
        "method": "POST",
        "url": "{{catalog_url}}/catalog/resource/key_write",
        "header": [
          {
