    {
      "name": "Bounded tenant registry",
      "request": {
        "method": "GET",
        "url": "{{catalog_backend}}/healthz",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const outcomes=[];function next(i){if(i===48){",
              " pm.test(\"registry pressure explicitly rejected\",()=>pm.expect(outcomes.some(x=>x.code===503&&x.reason===\"tenant_registry_full\")).to.eql(true));",
              " pm.test(\"churn has no unexpected failures\",()=>pm.expect(outcomes.every(x=>!x.error&&(x.code===200||(x.code===503&&x.reason===\"tenant_registry_full\")))).to.eql(true));return;}",
              " pm.sendRequest({url:pm.environment.get(\"catalog_url\")+\"/catalog/products?limit=1\",method:\"GET\",header:{\"X-Demo-Tenant\":\"pm-churn-\"+i}},(error,response)=>{outcomes.push({error:!!error,code:response?response.code:0,reason:response&&response.code===503?response.json().reason:null});next(i+1);});",
              "}next(0);"
            ]
          }
        }
      ]
    },
    {
      "name": "Aggregate-only tenant metrics",
      "request": {
        "method": "GET",
        "url": "{{catalog_url}}/metrics",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const text=pm.response.text();const m=text.match(/^gatewise_tenants_tracked\\{[^}]*service=\"catalog\"[^}]*\\}\\s+(\\d+)/m);",
              "pm.test(\"identified registry stays bounded\",()=>{pm.expect(m).to.not.eql(null);pm.expect(Number(m[1])).to.be.at.most(Number(pm.environment.get(\"tenant_max_tracked\")));});",
              "pm.test(\"aggregate tenant rejection metrics\",()=>pm.expect(text).to.include('reason=\"tenant_registry_full\"'));",
              "pm.test(\"tenant identities absent from metrics\",()=>{pm.expect(text).to.not.include(\"pm-churn\");pm.expect(text).to.not.include(\"pm-noisy\");});",
              "pm.test(\"sharing metrics are present\",()=>pm.expect(pm.response.text()).includes(\"gatewise_tenant_sharing_demanding_tenants\"));"
            ]
          }
        }
      ]
    },
