{
  "info": {
    "name": "Gatewise tenant sharing",
    "description": "Run against a fresh launch with --sharing 4. The tenant limit 2 is a target share; borrowing ceiling 4 is total concurrent work per identity, not four extra slots. Checks borrowing, unrelated tenant progress, bounded tracking and aggregate metrics. Local synthetic identities are not authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({key:\"X-Demo-Tenant\",value:\"contract\"});",
          "if(pm.info.requestName.startsWith(\"Missing\"))pm.request.headers.remove(\"X-Demo-Tenant\");",
          "if(pm.info.requestName===\"Malformed identity\")pm.request.headers.upsert({key:\"X-Demo-Tenant\",value:\"invalid tenant\"});",
          "if(pm.info.requestName===\"Tenant checkout\")pm.collectionVariables.set(\"tenant_order_key\",pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health outside admission",
      "request": {
        "method": "GET",
        "url": "{{orders_url}}/healthz",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Tenant checkout",
      "request": {
        "method": "POST",
        "url": "{{orders_url}}/orders/checkout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{tenant_order_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"amount_cents\": 1234}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"tenant_order_id\",pm.response.json().id);pm.test(\"protected mode\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Mode\")).to.eql(pm.environment.get(\"expected_mode\")));",
              "pm.test(\"sharing admission diagnosed\",()=>pm.expect([\"share\",\"borrowed\"]).includes(pm.response.headers.get(\"X-Gatewise-Tenant-Admission\")));"
            ]
          }
        }
      ]
    },
