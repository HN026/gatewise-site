    {
      "name": "Noisy tenant versus ordinary tenants",
      "request": {
        "method": "GET",
        "url": "{{orders_url}}/healthz",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "let left=15;const outcomes=[];",
              "for(let i=0;i<15;i++){",
              " const noisy=i<12;const tenant=noisy?\"pm-noisy\":\"pm-ordinary-\"+i;",
              " pm.sendRequest({url:pm.environment.get(\"orders_url\")+\"/orders/checkout\",method:\"POST\",header:{\"Content-Type\":\"application/json\",\"Idempotency-Key\":pm.variables.replaceIn(\"{{$guid}}\"),\"X-Demo-Tenant\":tenant},body:{mode:\"raw\",raw:JSON.stringify({amount_cents:1000})}},(error,response)=>{",
              "  outcomes.push({noisy,error:!!error,code:response?response.code:0,allocation:response?response.headers.get(\"X-Gatewise-Tenant-Admission\"):null,reason:response&&response.code===503?response.json().reason:null});",
              "  if(--left===0){",
              "   pm.test(\"no transport errors\",()=>pm.expect(outcomes.every(x=>!x.error)).to.eql(true));",
              "   pm.test(\"noisy tenant explicitly limited\",()=>pm.expect(outcomes.some(x=>x.noisy&&x.code===503&&x.reason===\"tenant_concurrency_limit\")).to.eql(true));",
              "   pm.test(\"spare capacity was borrowed\",()=>pm.expect(outcomes.some(x=>x.noisy&&x.code===201&&x.allocation===\"borrowed\")).to.eql(true));",
              "   pm.test(\"all three ordinary tenants complete\",()=>pm.expect(outcomes.filter(x=>!x.noisy&&x.code===201).length).to.eql(3));",
              "   pm.test(\"no unexpected SQL or gateway failures\",()=>pm.expect(outcomes.every(x=>[201,503].includes(x.code))).to.eql(true));",
              "  }",
              " });",
              "}"
            ]
          }
        }
      ]
    },
