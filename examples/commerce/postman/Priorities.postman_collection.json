      ]
    },
    {
      "name": "Trusted incoming priority overrides route default",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Gatewise-Priority",
            "value": "v1;urgent;aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ],
        "url": "{{orders_url}}/orders/flows/batch"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"trusted priority accepted\",()=>pm.response.to.have.status(200));const b=pm.response.json();pm.test(\"urgent survives both hops\",()=>{pm.expect(b.upstream.Tier).eq(\"urgent\");pm.expect(b.downstream.priority.Tier).eq(\"urgent\");pm.expect(b.upstream.Source).eq(\"trusted_http\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Malformed",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Gatewise-Priority",
            "value": "urgent"
          }
        ],
        "url": "{{orders_url}}/orders/flows/batch"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invalid metadata rejected\",()=>pm.response.to.have.status(400));pm.test(\"explicit reason\",()=>pm.expect(pm.response.json().reason).eq(\"priority_metadata_invalid\"));"
            ]
          }
        }
      ]
    },
