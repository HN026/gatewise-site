    {
      "name": "Legacy critical maps to highest tier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{orders_url}}/orders/checkout",
        "body": {
          "mode": "raw",
          "raw": "{\"amount_cents\": 1000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"checkout accepted\",()=>pm.response.to.have.status(201));pm.test(\"critical compatibility\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Resolved-Priority\")).eq(\"urgent\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Legacy background maps to lowest tier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{orders_url}}/orders/reports/rebuild",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"report accepted\",()=>pm.response.to.have.status(200));pm.test(\"background compatibility\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Resolved-Priority\")).eq(\"batch\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Downstream default is batch",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{catalog_url}}/catalog/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"products accepted\",()=>pm.response.to.have.status(200));pm.test(\"server-side default\",()=>pm.expect(pm.response.json().priority.Tier).eq(\"batch\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bounded priority metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{catalog_url}}/metrics"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"metrics available\",()=>pm.response.to.have.status(200));const t=pm.response.text();pm.test(\"resolved source is observable\",()=>{pm.expect(t).includes('gatewise_priority_resolutions_total');pm.expect(t).includes('source=\"trusted_http\"');});pm.test(\"cohort keys are not metric labels\",()=>{pm.expect(t).not.includes('aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa');pm.expect(t).not.includes('cohort_key=');});"
            ]
          }
        }
      ]
    }
  ]
}
