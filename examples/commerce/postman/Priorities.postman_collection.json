{
  "info": {
    "name": "Gatewise priority propagation",
    "description": "Real orders-to-catalog database-backed flows. Loopback peers are trusted only for this isolated demo. It does not authenticate users. Forged remote peers are covered by Go trust-boundary tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Default urgent",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{orders_url}}/orders/flows/urgent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"flow succeeds\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"importance survives downstream\",()=>{pm.expect(b.upstream.Tier).eq(\"urgent\");pm.expect(b.downstream.priority.Tier).eq(\"urgent\");});",
              "pm.test(\"downstream source is trusted HTTP\",()=>pm.expect(b.downstream.priority.Source).eq(\"trusted_http\"));",
              "pm.test(\"cohort is consistent within one epoch\",()=>{if(b.upstream.Epoch===b.downstream.priority.Epoch)pm.expect(b.upstream.Bucket).eq(b.downstream.priority.Bucket);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Default normal",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{orders_url}}/orders/flows/normal"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"flow succeeds\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"importance survives downstream\",()=>{pm.expect(b.upstream.Tier).eq(\"normal\");pm.expect(b.downstream.priority.Tier).eq(\"normal\");});",
              "pm.test(\"downstream source is trusted HTTP\",()=>pm.expect(b.downstream.priority.Source).eq(\"trusted_http\"));",
              "pm.test(\"cohort is consistent within one epoch\",()=>{if(b.upstream.Epoch===b.downstream.priority.Epoch)pm.expect(b.upstream.Bucket).eq(b.downstream.priority.Bucket);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Default batch",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{orders_url}}/orders/flows/batch"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"flow succeeds\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test(\"importance survives downstream\",()=>{pm.expect(b.upstream.Tier).eq(\"batch\");pm.expect(b.downstream.priority.Tier).eq(\"batch\");});",
              "pm.test(\"downstream source is trusted HTTP\",()=>pm.expect(b.downstream.priority.Source).eq(\"trusted_http\"));",
              "pm.test(\"cohort is consistent within one epoch\",()=>{if(b.upstream.Epoch===b.downstream.priority.Epoch)pm.expect(b.upstream.Bucket).eq(b.downstream.priority.Bucket);});"
            ]
          }
