    {
      "name": "Concurrent admission and reservation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{orders_url}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "const n=20;let left=n;const outcomes=[];",
              "for(let i=0;i<n;i++){",
              " const critical=i>=16;",
              " pm.sendRequest({url:pm.environment.get(\"orders_url\")+(critical?\"/orders/checkout\":\"/orders/reports/rebuild\"),method:\"POST\",header:{\"Content-Type\":\"application/json\",\"Idempotency-Key\":pm.variables.replaceIn(\"{{$guid}}\")},body:{mode:\"raw\",raw:critical?JSON.stringify({amount_cents:1000}):\"{}\"}},(err,res)=>{",
              "  outcomes.push({critical,code:res?res.code:0,error:!!err});",
              "  if(--left===0){",
              "   pm.test(\"bounded batch completed without transport errors\",()=>pm.expect(outcomes.some(x=>x.error)).to.eql(false));",
              "   pm.test(\"critical traffic has successful work\",()=>pm.expect(outcomes.some(x=>x.critical&&x.code>=200&&x.code<300)).to.eql(true));",
              "   pm.test(\"admission sheds background pressure\",()=>{if(pm.environment.get(\"expected_mode\")!==\"direct\")pm.expect(outcomes.some(x=>!x.critical&&x.code===503)).to.eql(true);});",
              "  }",
              " });",
              "}"
            ]
          }
        }
      ]
    },
