{
  "info": {
    "name": "Gatewise commerce example",
    "description": "Disposable PostgreSQL-backed orders, catalog and inventory APIs. Run the full collection in order against a fresh launcher environment. Includes persistence, idempotency, stock consistency, input errors, SQL faults, admission and recovery. Controls are separate loopback-only listeners. No credentials or external API calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.requestName===\"Create checkout\")pm.collectionVariables.set(\"checkout_key\",pm.variables.replaceIn(\"{{$guid}}\"));",
          "if(pm.info.requestName===\"Create reservation\")pm.collectionVariables.set(\"reservation_key\",pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{orders_url}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"database ready\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{checkout_key}}"
          }
        ],
        "url": "{{orders_url}}/orders/checkout",
        "body": {
          "mode": "raw",
          "raw": "{\"amount_cents\": 1234}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const order=pm.response.json(); pm.collectionVariables.set(\"order_id\",order.id); pm.test(\"persisted order shape\",()=>{pm.expect(order.id).to.be.a(\"string\");pm.expect(order.amount_cents).to.eql(1234);pm.expect(order.status).to.eql(\"confirmed\");});pm.test(\"mode header\",()=>{const mode=pm.environment.get(\"expected_mode\");if(mode!==\"direct\")pm.expect(pm.response.headers.get(\"X-Gatewise-Mode\")).to.eql(mode);});"
            ]
          }
        }
      ]
    },
