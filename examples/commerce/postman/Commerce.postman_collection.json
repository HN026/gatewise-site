    {
      "name": "Concurrent reservation replay",
      "request": {
        "method": "GET",
        "url": "{{inventory_url}}/inventory/stock/19998"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"stock_before_concurrent\",pm.response.json().available);",
              "const key=pm.variables.replaceIn(\"{{$guid}}\");let left=5;const outcomes=[];",
              "for(let i=0;i<5;i++)pm.sendRequest({url:pm.environment.get(\"inventory_url\")+\"/inventory/reservations\",method:\"POST\",header:{\"Content-Type\":\"application/json\",\"Idempotency-Key\":key},body:{mode:\"raw\",raw:JSON.stringify({product_id:19998,quantity:1})}},(error,response)=>{",
              " outcomes.push({error:!!error,code:response?response.code:0,id:response&&response.code<300?response.json().id:null});",
              " if(--left===0){",
              "  pm.test(\"concurrent reservation requests complete\",()=>pm.expect(outcomes.every(x=>!x.error&&[200,201].includes(x.code))).to.eql(true));",
              "  pm.test(\"exactly one concurrent insert\",()=>pm.expect(outcomes.filter(x=>x.code===201).length).to.eql(1));",
              "  pm.test(\"same reservation across concurrent replays\",()=>pm.expect(new Set(outcomes.map(x=>x.id)).size).to.eql(1));",
              " }",
              "});"
            ]
          }
        }
      ]
    },
