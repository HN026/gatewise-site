              "pm.test(\"bounded engine metrics\",()=>{const t=pm.response.text();pm.expect(t).includes(\"gatewise_signal_state\");pm.expect(t).includes(\"gatewise_signal_proposals_total\");pm.expect(t).includes(\"gatewise_signal_collection_failures_total\");});"
            ]
          }
        }
      ]
    },
