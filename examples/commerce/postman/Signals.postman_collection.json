    {
      "name": "Healthy observations permit work",
      "request": {
        "method": "GET",
        "url": "{{catalog_url}}/catalog/products?limit=5",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Gatewise-Decision-Mode",
            "value": "observe"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(()=>{}, 400);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const mode=pm.environment.get(\"decision_mode\"); const blocked=mode===\"enforce\" && false; pm.test(\"expected outcome\",()=>pm.response.to.have.status(blocked?503:200));",
              "pm.test(\"server owns decision mode\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Decision-Mode\")).to.eql(mode));",
              "pm.test(\"cached proposal\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Signal-Proposal\")).to.eql(\"allow\"));"
            ]
          }
        }
      ]
    },
