    {
      "name": "Reject dominates healthy observation",
      "request": {
        "method": "GET",
        "url": "{{catalog_url}}/catalog/products?limit=5",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Gatewise-Decision-Mode",
            "value": "observe"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(()=>{}, 400);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const mode=pm.environment.get(\"decision_mode\"); const blocked=mode===\"enforce\" && true; pm.test(\"expected outcome\",()=>pm.response.to.have.status(blocked?503:200));",
              "pm.test(\"server owns decision mode\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Decision-Mode\")).to.eql(mode));",
              "pm.test(\"cached proposal\",()=>pm.expect(pm.response.headers.get(\"X-Gatewise-Signal-Proposal\")).to.eql(\"reject\"));",
              "if(blocked){const d=pm.response.json().decision;pm.test(\"rejected before tenant or capacity work\",()=>{pm.expect(d.Stage).to.eql(\"signals\");pm.expect(d.Stages.find(s=>s.Name===\"capacity\").State).to.eql(\"not_evaluated\");});pm.test(\"explicit pressure reason\",()=>pm.expect(d.Reason).to.eql(\"signal_pressure\"));}"
            ]
          }
        }
      ]
    },
