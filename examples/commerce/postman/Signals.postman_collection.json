{
  "info": {
    "name": "Gatewise controlled signals",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run run.py --decisions enforce or observe --verify. Real SQL services; controlled loopback signal providers, not automatic resource sensors. Example thresholds/caps only."
  },
  "item": [
    {
      "name": "Reset primary",
      "request": {
        "method": "PUT",
        "url": "{{catalog_admin}}/signals/primary",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Gatewise-Decision-Mode",
            "value": "observe"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"value\": 0.2, \"state\": \"measured\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"control accepted\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
