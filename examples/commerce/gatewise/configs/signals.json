{
  "listen_addr": "127.0.0.1:8080",
  "services": {
    "orders": {
      "upstream_url": "http://127.0.0.1:9090",
      "max_concurrent": 20,
      "reserved_critical": 5,
      "decisions": {
        "mode": "observe",
        "signals": [
          {
            "name": "pool_pressure",
            "threshold": 0.8,
            "max_age": "2s",
            "on_unknown": "limit",
            "unknown_limit": 6,
            "pressure": {
              "max_concurrent": 8
            },
            "source": {
              "url": "${ORDERS_PRESSURE_URL}",
              "interval": "250ms",
              "timeout": "100ms"
            }
          }
        ]
      }
    }
  },
  "routes": [
    {
      "path_prefix": "/orders",
      "service": "orders",
      "strip_prefix": true,
      "priority": "critical"
    },
    {
      "path_prefix": "/orders/reports",
      "service": "orders",
      "strip_prefix": true,
      "priority": "background"
    }
  ]
}
