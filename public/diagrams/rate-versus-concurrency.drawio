" value="Concurrency ceiling: 20&#10;Example limit, chosen by operator" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#142019;strokeColor=#6faf91;fontColor=#dce7df;fontSize=14;"><mxGeometry x="20" y="150" width="240" height="66" as="geometry" /></mxCell><mxCell id="active" value="At most 20 active&#10;Slots held until handlers return" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#142019;strokeColor=#6faf91;fontColor=#dce7df;fontSize=14;"><mxGeometry x="320" y="150" width="240" height="66" as="geometry" /></mxCell><mxCell id="reject" value="Excess arrivals: 503&#10;No additional admission queue" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#142019;strokeColor=#4a6051;fontColor=#dce7df;fontSize=14;"><mxGeometry x="620" y="150" width="240" height="66" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>